<!--
  Closet panel: a sheet of pattern paper with states toggled by ClosetSystem:
  browse (streak, lookbook, closet + stylist actions), design (garment
  builder chips), stylist (occasion / weather / mood, then a previewed
  proposal), week (planner, packing) and boutique (verdict). Buttons are plain
  styled divs (click handlers by id) in the same paper-and-ink style as the
  studio panel.
-->
<style>
  .sheet {
    flex-direction: column;
    width: 460px;
    border-radius: 18px;
    border-width: 2px;
    border-color: #d8ccb6;
    background-color: #f4ede1;
  }

  .content {
    flex-direction: column;
    gap: 7px;
    padding-top: 20px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 10px;
  }

  .label {
    color: #8a7a66;
    font-size: 17px;
    font-weight: 500;
  }

  .heading {
    color: #2a231c;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.15;
  }

  .note {
    color: #4a4036;
    font-size: 19px;
    line-height: 1.35;
  }

  .section {
    flex-direction: column;
    gap: 7px;
    margin-top: 4px;
  }

  .row-label {
    color: #8a7a66;
    font-size: 16px;
    font-weight: 500;
    margin-top: 6px;
  }

  .row {
    flex-direction: row;
    gap: 7px;
  }

  .chip {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    padding-top: 9px;
    padding-bottom: 9px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #cbbda5;
    background-color: #fbf7f0;
    color: #2a231c;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }

  .chip:hover {
    border-color: #2a231c;
  }

  .dot {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 3px;
    border-color: #cbbda5;
    cursor: pointer;
  }

  .streak {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
  }

  .badge {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 72px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #d8ccb6;
    background-color: #fbf7f0;
  }

  .badge-count {
    color: #2a231c;
    font-size: 32px;
    font-weight: 600;
    line-height: 1;
  }

  .badge-label {
    color: #8a7a66;
    font-size: 13px;
    font-weight: 500;
  }

  .streak-text {
    flex-direction: column;
    flex-shrink: 1;
    gap: 2px;
  }

  .streak-title {
    color: #2a231c;
    font-size: 19px;
    font-weight: 600;
  }

  .streak-sub {
    color: #5c5146;
    font-size: 16px;
    line-height: 1.3;
  }

  .wear {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    padding-top: 10px;
    border-top-width: 2px;
    border-color: #e0d5c2;
  }

  .wear-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    color: #5c5146;
    font-size: 16px;
    line-height: 1.3;
  }

  .chip-fixed {
    align-items: center;
    justify-content: center;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #2a231c;
    background-color: #fbf7f0;
    color: #2a231c;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }

  .chip-fixed:hover {
    background-color: #ffffff;
  }

  .tip {
    margin-top: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 8px;
    background-color: #ebe2d2;
    color: #3d3329;
    font-size: 17px;
    line-height: 1.35;
  }

  .verdict {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }

  .verdict-badge {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 98px;
    height: 72px;
    border-radius: 14px;
    background-color: #2a231c;
  }

  .verdict-word {
    color: #f7f1e6;
    font-size: 26px;
    font-weight: 600;
  }

  .verdict-label {
    color: #e8dcc8;
    font-size: 13px;
  }

  .actions {
    flex-direction: row;
    gap: 10px;
    padding-top: 8px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 18px;
  }

  .btn {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 52px;
    border-radius: 26px;
    border-width: 2px;
    border-color: #cbbda5;
    background-color: #fbf7f0;
    color: #2a231c;
    font-size: 18px;
    font-weight: 500;
    cursor: pointer;
  }

  .btn:hover {
    border-color: #2a231c;
    background-color: #ffffff;
  }

  .btn:active {
    background-color: #e8dcc8;
  }

  .btn-main {
    border-color: #2a231c;
    background-color: #2a231c;
    color: #f7f1e6;
  }

  .btn-main:hover {
    border-color: #43382d;
    background-color: #43382d;
  }

  .icon {
    width: 21px;
    height: 21px;
  }

  .links {
    flex-direction: row;
    gap: 4px;
    padding-left: 18px;
    padding-right: 18px;
    padding-bottom: 14px;
  }

  .link {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    color: #5c5146;
    font-size: 17px;
    cursor: pointer;
  }

  .link:hover {
    background-color: #e8dcc8;
    color: #2a231c;
  }

  .small-icon {
    width: 18px;
    height: 18px;
  }
</style>
<div class="sheet">
  <div class="content">
    <div id="closet-eyebrow" class="label">My closet</div>
    <div id="closet-title" class="heading">Your closet</div>
    <div id="closet-note" class="note">Recreate clothes you own, then mix them on the form.</div>
    <div id="morning-section" class="section">
      <div id="morning-label" class="row-label">This morning</div>
      <div id="morning-text" class="streak-sub">Pick today's weather in the stylist, or check it on the start page.</div>
      <div class="row">
        <div id="morning-today" class="chip">Dress me for today</div>
        <div id="morning-tomorrow" class="chip">Lay out tomorrow</div>
      </div>
    </div>
    <div id="streak-row" class="streak">
      <div id="streak-badge" class="badge">
        <div id="streak-count" class="badge-count">0</div>
        <div class="badge-label">day streak</div>
      </div>
      <div class="streak-text">
        <div id="streak-title" class="streak-title">Outfit of the Day</div>
        <div id="streak-sub" class="streak-sub">Dress the form, then tap Wear today.</div>
      </div>
    </div>
    <div id="wear-row" class="wear">
      <div id="wear-text" class="wear-text">Least worn: a piece you have not worn yet.</div>
      <div id="style-it" class="chip-fixed">Style it</div>
    </div>
    <div id="lookbook-section" class="section">
      <div class="row-label">Lookbook</div>
      <div id="lookbook-empty" class="streak-sub">Save a look you love and it waits for you here.</div>
      <div class="row">
        <div id="lb-0" class="chip" style="display: none">Look</div>
        <div id="lb-1" class="chip" style="display: none">Look</div>
        <div id="lb-2" class="chip" style="display: none">Look</div>
      </div>
      <div class="row">
        <div id="lb-3" class="chip" style="display: none">Look</div>
        <div id="lb-4" class="chip" style="display: none">Look</div>
        <div id="lb-5" class="chip" style="display: none">Look</div>
      </div>
    </div>
    <div id="stylist-section" class="section" style="display: none">
      <div class="row-label">Occasion</div>
      <div class="row">
        <div id="occ-work" class="chip">Work</div>
        <div id="occ-interview" class="chip">Interview</div>
        <div id="occ-date" class="chip">Date</div>
      </div>
      <div class="row">
        <div id="occ-weekend" class="chip">Weekend</div>
        <div id="occ-party" class="chip">Party</div>
        <div id="occ-travel" class="chip">Travel</div>
      </div>
      <div class="row-label">Weather</div>
      <div class="row">
        <div id="wx-warm" class="chip">Warm</div>
        <div id="wx-mild" class="chip">Mild</div>
        <div id="wx-cold" class="chip">Cold</div>
        <div id="wx-rainy" class="chip">Rainy</div>
      </div>
      <div class="row-label">Mood</div>
      <div class="row">
        <div id="mood-classic" class="chip">Classic</div>
        <div id="mood-bold" class="chip">Bold</div>
        <div id="mood-relaxed" class="chip">Relaxed</div>
      </div>
      <div id="stylist-tip" class="tip" style="display: none">Tip</div>
      <div id="stylist-meta" class="streak-sub" style="display: none">Meta</div>
      <div id="refine-section" class="section" style="display: none">
        <div class="row-label">Refine this look</div>
        <div class="row">
          <div id="refine-warmer" class="chip">Warmer</div>
          <div id="refine-dressier" class="chip">Dressier</div>
          <div id="refine-colour" class="chip">More colour</div>
        </div>
      </div>
    </div>
    <div id="week-section" class="section" style="display: none">
      <div class="row-label">Your week: tap a day to wear it</div>
      <div class="row">
        <div id="wk-0" class="chip">Mon</div>
        <div id="wk-1" class="chip">Tue</div>
        <div id="wk-2" class="chip">Wed</div>
        <div id="wk-3" class="chip">Thu</div>
        <div id="wk-4" class="chip">Fri</div>
        <div id="wk-5" class="chip">Sat</div>
        <div id="wk-6" class="chip">Sun</div>
      </div>
      <div id="week-summary" class="streak-sub">Seven outfits from your closet.</div>
      <div class="row-label">Pack for a trip</div>
      <div class="row">
        <div id="pack-3" class="chip">3 days</div>
        <div id="pack-5" class="chip">5 days</div>
        <div id="pack-7" class="chip">7 days</div>
      </div>
      <div id="pack-list" class="tip" style="display: none">Pack</div>
    </div>
    <div id="boutique-section" class="section" style="display: none">
      <div class="row-label">Boutiques</div>
      <div class="row">
        <div id="shop-0" class="chip">Maison Lune</div>
        <div id="shop-1" class="chip">Studio Nord</div>
        <div id="shop-2" class="chip">Sol and Sable</div>
      </div>
      <div id="verdict-card" class="section" style="display: none">
        <div class="verdict">
          <div id="verdict-badge" class="verdict-badge">
            <div id="verdict-word" class="verdict-word">Buy</div>
            <div class="verdict-label">verdict</div>
          </div>
          <div class="streak-text">
            <div id="verdict-stat" class="streak-title">+6 new outfits</div>
            <div id="verdict-sub" class="streak-sub">About $24 per outfit</div>
          </div>
        </div>
        <div id="verdict-reason" class="tip">Reason</div>
      </div>
    </div>
    <div id="design-section" class="section" style="display: none">
      <div class="row-label">Garment</div>
      <div class="row">
        <div id="tpl-top" class="chip">Top</div>
        <div id="tpl-trousers" class="chip">Trousers</div>
        <div id="tpl-skirt" class="chip">Skirt</div>
        <div id="tpl-dress" class="chip">Dress</div>
        <div id="tpl-jacket" class="chip">Jacket</div>
      </div>
      <div class="row-label">Colour</div>
      <div class="row">
        <div id="col-white" class="dot" style="background-color: #f4f2ec"></div>
        <div id="col-cream" class="dot" style="background-color: #e9dcc0"></div>
        <div id="col-camel" class="dot" style="background-color: #b98a5a"></div>
        <div id="col-pink" class="dot" style="background-color: #e7a6b0"></div>
        <div id="col-red" class="dot" style="background-color: #a8262f"></div>
        <div id="col-green" class="dot" style="background-color: #4f6b45"></div>
        <div id="col-blue" class="dot" style="background-color: #4a77b4"></div>
        <div id="col-navy" class="dot" style="background-color: #1f2d52"></div>
        <div id="col-grey" class="dot" style="background-color: #8b8d93"></div>
        <div id="col-black" class="dot" style="background-color: #1a1a1d"></div>
      </div>
      <div class="row-label">Fabric</div>
      <div class="row">
        <div id="mat-cotton" class="chip">Cotton</div>
        <div id="mat-satin" class="chip">Satin</div>
        <div id="mat-knit" class="chip">Knit</div>
        <div id="mat-wool" class="chip">Wool</div>
        <div id="mat-denim" class="chip">Denim</div>
      </div>
      <div class="row">
        <div id="mat-stripe" class="chip">Stripe</div>
        <div id="mat-check" class="chip">Check</div>
        <div id="mat-plaid" class="chip">Plaid</div>
        <div id="mat-dots" class="chip">Dots</div>
        <div id="mat-floral" class="chip">Floral</div>
      </div>
      <div class="row-label">What it cost (for cost per wear)</div>
      <div class="row">
        <div id="price-25" class="chip">$25</div>
        <div id="price-50" class="chip">$50</div>
        <div id="price-100" class="chip">$100</div>
        <div id="price-200" class="chip">$200</div>
        <div id="price-400" class="chip">$400</div>
      </div>
    </div>
  </div>
  <div id="browse-actions-2" class="actions" style="padding-bottom: 6px">
    <div id="stylist-button" class="btn btn-main">
      <Sparkles class="icon"></Sparkles>
      <div>Ask stylist</div>
    </div>
    <div id="today-button" class="btn">
      <CalendarCheck class="icon"></CalendarCheck>
      <div>Wear today</div>
    </div>
    <div id="save-look-button" class="btn">
      <Bookmark class="icon"></Bookmark>
      <div>Save look</div>
    </div>
  </div>
  <div id="browse-actions" class="links">
    <div id="new-button" class="link">
      <Plus class="small-icon"></Plus>
      <div>New piece</div>
    </div>
    <div id="edit-button" class="link">
      <Pencil class="small-icon"></Pencil>
      <div>Edit</div>
    </div>
    <div id="remove-button" class="link">
      <Trash2 class="small-icon"></Trash2>
      <div>Remove</div>
    </div>
  </div>
  <div id="stylist-actions" class="actions" style="display: none">
    <div id="style-button" class="btn btn-main">
      <Sparkles class="icon"></Sparkles>
      <div id="style-label">Style me</div>
    </div>
    <div id="week-button" class="btn">
      <CalendarDays class="icon"></CalendarDays>
      <div>Plan week</div>
    </div>
    <div id="stylist-back" class="btn">
      <ArrowLeft class="icon"></ArrowLeft>
      <div>Back</div>
    </div>
  </div>
  <div id="week-actions" class="actions" style="display: none">
    <div id="week-replan" class="btn btn-main">
      <RefreshCw class="icon"></RefreshCw>
      <div>Replan</div>
    </div>
    <div id="week-back" class="btn">
      <ArrowLeft class="icon"></ArrowLeft>
      <div>Back</div>
    </div>
  </div>
  <div id="proposal-actions" class="actions" style="display: none">
    <div id="keep-button" class="btn btn-main">
      <Check class="icon"></Check>
      <div>Keep</div>
    </div>
    <div id="next-button" class="btn">
      <Shuffle class="icon"></Shuffle>
      <div id="next-label">Next idea</div>
    </div>
    <div id="revert-button" class="btn">
      <Undo2 class="icon"></Undo2>
      <div>Undo</div>
    </div>
  </div>
  <div id="boutique-actions" class="actions" style="display: none">
    <div id="add-closet-button" class="btn btn-main">
      <ShoppingBag class="icon"></ShoppingBag>
      <div id="add-closet-label">Add to closet</div>
    </div>
    <div id="pairing-button" class="btn">
      <Shuffle class="icon"></Shuffle>
      <div>Next pairing</div>
    </div>
    <div id="boutique-back" class="btn">
      <ArrowLeft class="icon"></ArrowLeft>
      <div>Back</div>
    </div>
  </div>
  <div id="design-actions" class="actions" style="display: none">
    <div id="save-button" class="btn btn-main">
      <Check class="icon"></Check>
      <div>Save to closet</div>
    </div>
    <div id="cancel-button" class="btn">
      <X class="icon"></X>
      <div>Cancel</div>
    </div>
  </div>
</div>
