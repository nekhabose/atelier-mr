<!--
  Atelier status panel. Text nodes with ids are updated at runtime by
  AtelierPanelSystem (look name, designer note, contextual hint).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .panel-content {
    flex-direction: column;
    gap: 6px;
    padding-top: 22px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 14px;
  }

  .eyebrow {
    color: #8a6a2f;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .eyebrow:dark {
    color: #e2c27d;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .note {
    color: #3a3b40;
    font-size: 19px;
    line-height: 26px;
  }

  .note:dark {
    color: #d8d9dd;
  }

  .hint {
    margin-top: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #f3ead8;
    color: #5a4520;
    font-size: 18px;
    line-height: 24px;
  }

  .hint:dark {
    background-color: #3a3122;
    color: #f1dfb6;
  }

  .actions {
    flex-direction: row;
    gap: 10px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 14px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
  .access {
    flex-direction: column;
    gap: 8px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #f3ead8;
  }

  .access:dark {
    background-color: #24221e;
  }

  .toggle-row {
    flex-direction: row;
    gap: 8px;
  }

  .toggle {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    padding-top: 9px;
    padding-bottom: 9px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #d9d3c7;
    background-color: #fbf8f2;
    color: #2b2118;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle:dark {
    border-color: #4a4d55;
    background-color: #2c2e33;
    color: #f1ede4;
  }

  .small {
    color: #5a4520;
    font-size: 15px;
    line-height: 20px;
  }

  .small:dark {
    color: #d8cfbf;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">ATELIER  |  HANDS-FIRST STUDIO</div>
    <div id="look-name" class="heading">Choose a look</div>
    <div id="look-note" class="note">Tap any outfit on the brass rail to dress the form.</div>
    <div id="hint" class="hint">Pinch a gold pin and pull to tailor. Drop a fabric swatch on the form to re-skin it.</div>
  </div>
  <div class="actions">
    <Button id="xr-button">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel class="button-label">Enter Atelier</ButtonLabel>
    </Button>
    <Button id="exit-button" style="display: none">
      <ButtonIcon>
        <LogIn></LogIn>
      </ButtonIcon>
      <ButtonLabel class="button-label">Exit</ButtonLabel>
    </Button>
    <Button id="reset-button">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel class="button-label">Reset look</ButtonLabel>
    </Button>
  </div>
  <div id="edit-actions" class="actions">
    <Button id="undo-button" variant="secondary">
      <ButtonIcon>
        <Undo2></Undo2>
      </ButtonIcon>
      <ButtonLabel class="button-label">Undo</ButtonLabel>
    </Button>
    <Button id="redo-button" variant="secondary">
      <ButtonIcon>
        <Redo2></Redo2>
      </ButtonIcon>
      <ButtonLabel class="button-label">Redo</ButtonLabel>
    </Button>
    <Button id="turn-button" variant="secondary">
      <ButtonIcon>
        <RotateCw></RotateCw>
      </ButtonIcon>
      <ButtonLabel class="button-label">Turn</ButtonLabel>
    </Button>
    <Button id="share-button" variant="secondary">
      <ButtonIcon>
        <Share2></Share2>
      </ButtonIcon>
      <ButtonLabel class="button-label">Share</ButtonLabel>
    </Button>
  </div>
  <div class="actions">
    <Button id="place-button" variant="secondary">
      <ButtonIcon>
        <LocateFixed></LocateFixed>
      </ButtonIcon>
      <ButtonLabel class="button-label">Move studio</ButtonLabel>
    </Button>
    <Button id="tour-button" variant="secondary">
      <ButtonIcon>
        <Hand></Hand>
      </ButtonIcon>
      <ButtonLabel id="tour-label" class="button-label">Tour</ButtonLabel>
    </Button>
    <Button id="access-button" variant="secondary">
      <ButtonIcon>
        <Accessibility></Accessibility>
      </ButtonIcon>
      <ButtonLabel id="access-label" class="button-label">Access</ButtonLabel>
    </Button>
  </div>
  <div id="access-section" class="access" style="display: none">
    <div class="eyebrow">ACCESSIBILITY</div>
    <div class="toggle-row">
      <div id="acc-largeText" class="toggle">Large text</div>
      <div id="acc-highContrast" class="toggle">High contrast</div>
      <div id="acc-calmMotion" class="toggle">Calm motion</div>
    </div>
    <div class="toggle-row">
      <div id="acc-readAloud" class="toggle">Read aloud</div>
      <div id="acc-voice" class="toggle">Voice commands</div>
    </div>
    <div class="eyebrow">TAILOR WITHOUT DRAGGING</div>
    <div class="toggle-row">
      <div id="tl-hem-up" class="toggle">Shorter</div>
      <div id="tl-hem-down" class="toggle">Longer</div>
      <div id="tl-fit-up" class="toggle">Waist in</div>
      <div id="tl-fit-down" class="toggle">Waist out</div>
    </div>
    <div class="toggle-row">
      <div id="tl-sleeve-down" class="toggle">Sleeves shorter</div>
      <div id="tl-sleeve-up" class="toggle">Sleeves longer</div>
    </div>
    <div id="access-status" class="small">Settings stay on this device.</div>
  </div>
</Panel>
