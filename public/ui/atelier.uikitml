<!--
  Atelier studio panel: a sheet of pattern paper. Text nodes with ids are
  updated at runtime (look name, designer note, contextual hint). Buttons are
  plain styled divs (click handlers by id), so the panel keeps its own
  paper-and-ink look instead of the kit's default glass.
-->
<style>
  .sheet {
    flex-direction: column;
    width: 460px;
    border-radius: 18px;
    border-width: 2px;
    border-color: #d8ccb6;
    background-color: #f4ede1;
  }

  .content {
    flex-direction: column;
    gap: 8px;
    padding-top: 22px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 12px;
  }

  .label {
    color: #8a7a66;
    font-size: 17px;
    font-weight: 500;
  }

  .heading {
    color: #2a231c;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
  }

  .note {
    color: #4a4036;
    font-size: 21px;
    line-height: 1.35;
  }

  .hint-row {
    flex-direction: row;
    margin-top: 6px;
    border-radius: 8px;
    background-color: #ebe2d2;
  }

  .stitch {
    width: 5px;
    border-radius: 3px;
    background-color: #a8442c;
  }

  .hint {
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 13px;
    padding-right: 14px;
    border-radius: 8px;
    color: #3d3329;
    font-size: 19px;
    line-height: 1.35;
  }

  .row {
    flex-direction: row;
    gap: 10px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 12px;
  }

  .btn {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 52px;
    border-radius: 26px;
    border-width: 2px;
    border-color: #cbbda5;
    background-color: #fbf7f0;
    color: #2a231c;
    font-size: 19px;
    font-weight: 500;
    cursor: pointer;
  }

  .btn:hover {
    border-color: #2a231c;
    background-color: #ffffff;
  }

  .btn:active {
    background-color: #e8dcc8;
  }

  .btn-main {
    border-color: #2a231c;
    background-color: #2a231c;
    color: #f7f1e6;
  }

  .btn-main:hover {
    background-color: #43382d;
    border-color: #43382d;
  }

  .icon {
    width: 22px;
    height: 22px;
  }

  .links {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
    padding-left: 18px;
    padding-right: 18px;
    padding-bottom: 16px;
    padding-top: 6px;
  }

  .divider {
    height: 2px;
    margin-left: 26px;
    margin-right: 26px;
    background-color: #e0d5c2;
  }

  .link {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    color: #5c5146;
    font-size: 18px;
    cursor: pointer;
  }

  .link:hover {
    background-color: #e8dcc8;
    color: #2a231c;
  }

  .small-icon {
    width: 18px;
    height: 18px;
  }

  .access {
    flex-direction: column;
    gap: 8px;
    margin-left: 26px;
    margin-right: 26px;
    margin-bottom: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: #ebe2d2;
  }

  .toggle-row {
    flex-direction: row;
    gap: 8px;
  }

  .toggle {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #cbbda5;
    background-color: #fbf7f0;
    color: #2a231c;
    font-size: 17px;
    font-weight: 500;
    cursor: pointer;
  }

  .toggle:hover {
    border-color: #2a231c;
  }

  .small {
    color: #5c5146;
    font-size: 16px;
    line-height: 1.3;
  }
</style>
<div class="sheet">
  <div class="content">
    <div class="label">Atelier, your fitting room</div>
    <div id="look-name" class="heading">Choose a look</div>
    <div id="look-note" class="note">Tap any outfit on the rail to dress the form.</div>
    <div class="hint-row">
      <div class="stitch"></div>
      <div id="hint" class="hint">Pinch a pin and pull to tailor. Drop a fabric swatch on the form to change it.</div>
    </div>
  </div>
  <div class="row">
    <div id="xr-button" class="btn btn-main">
      <RectangleGoggles class="icon"></RectangleGoggles>
      <div>Enter Atelier</div>
    </div>
    <div id="exit-button" class="btn btn-main" style="display: none">
      <LogIn class="icon"></LogIn>
      <div>Exit</div>
    </div>
  </div>
  <div id="edit-actions" class="row">
    <div id="undo-button" class="btn">
      <Undo2 class="icon"></Undo2>
      <div>Undo</div>
    </div>
    <div id="redo-button" class="btn">
      <Redo2 class="icon"></Redo2>
      <div>Redo</div>
    </div>
    <div id="turn-button" class="btn">
      <RotateCw class="icon"></RotateCw>
      <div>Turn</div>
    </div>
    <div id="share-button" class="btn">
      <Share2 class="icon"></Share2>
      <div>Share</div>
    </div>
  </div>
  <div class="divider"></div>
  <div class="links">
    <div id="reset-button" class="link">
      <RotateCcw class="small-icon"></RotateCcw>
      <div>Reset look</div>
    </div>
    <div id="place-button" class="link">
      <LocateFixed class="small-icon"></LocateFixed>
      <div>Move studio</div>
    </div>
    <div id="mark-button" class="link">
      <Ruler class="small-icon"></Ruler>
      <div id="mark-label">Mark on me</div>
    </div>
    <div id="tour-button" class="link">
      <Hand class="small-icon"></Hand>
      <div id="tour-label">Tour</div>
    </div>
    <div id="access-button" class="link">
      <Accessibility class="small-icon"></Accessibility>
      <div id="access-label">Access</div>
    </div>
  </div>
  <div id="access-section" class="access" style="display: none">
    <div class="label">Accessibility</div>
    <div class="toggle-row">
      <div id="acc-largeText" class="toggle">Large text</div>
      <div id="acc-highContrast" class="toggle">High contrast</div>
      <div id="acc-calmMotion" class="toggle">Calm motion</div>
    </div>
    <div class="toggle-row">
      <div id="acc-readAloud" class="toggle">Read aloud</div>
      <div id="acc-voice" class="toggle">Voice commands</div>
      <div id="acc-seated" class="toggle">Seated</div>
    </div>
    <div class="label">Tailor without dragging</div>
    <div class="toggle-row">
      <div id="tl-hem-up" class="toggle">Shorter</div>
      <div id="tl-hem-down" class="toggle">Longer</div>
      <div id="tl-fit-up" class="toggle">Waist in</div>
      <div id="tl-fit-down" class="toggle">Waist out</div>
    </div>
    <div class="toggle-row">
      <div id="tl-sleeve-down" class="toggle">Sleeves shorter</div>
      <div id="tl-sleeve-up" class="toggle">Sleeves longer</div>
    </div>
    <div id="access-status" class="small">Settings stay on this device.</div>
  </div>
</div>
